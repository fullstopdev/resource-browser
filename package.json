{
	"name": "resource-browser",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 0.0.0.0",
		"dev:ai": "PUBLIC_FIX_AI_ENABLED=true npm run build:cloudflare && wrangler pages dev .svelte-kit/cloudflare --ai AI --compatibility-date=2025-06-01 --compatibility-flag=nodejs_compat",
		"build": "vite build && node scripts/check-routes.mjs",
		"build:vercel": "ADAPTER=vercel vite build",
		"build:cloudflare": "node scripts/guard-static-dev-artifacts.mjs && npm run generate:all && PUBLIC_FIX_AI_ENABLED=true ADAPTER=cloudflare vite build && node scripts/prune-cloudflare-output.mjs",
		"prune:cloudflare": "node scripts/prune-cloudflare-output.mjs",
		"preview:cloudflare": "npm run prune:cloudflare && wrangler pages dev .svelte-kit/cloudflare --compatibility-date=2025-06-01 --compatibility-flag=nodejs_compat",
		"preview": "vite preview --host 0.0.0.0 --strictPort",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"generate:sitemap": "node scripts/generate-sitemap.mjs",
		"generate:release-notes": "tsx --tsconfig tsconfig.scripts.json scripts/generate-release-notes.ts",
		"warm:cache": "tsx --tsconfig tsconfig.scripts.json scripts/warm-cache.ts",
		"warm:cache:deterministic": "tsx --tsconfig tsconfig.scripts.json scripts/warm-cache.ts",
		"warm:cache:llm": "WARM_ACTIONS=explain,example tsx --tsconfig tsconfig.scripts.json scripts/warm-cache.ts",
		"audit:dependencies": "tsx --tsconfig tsconfig.scripts.json scripts/audit-dependency-corpus.ts",
		"build:dependency-graph": "tsx --tsconfig tsconfig.scripts.json scripts/build-dependency-graph.ts",
		"build:schema-graph": "tsx --tsconfig tsconfig.scripts.json scripts/build-schema-graph.ts",
		"sync:openapi": "./static/sync-openapi.sh",
		"generate:openapi-manifest": "tsx --tsconfig tsconfig.scripts.json scripts/generate-openapi-manifest.ts",
		"prebuild": "npm run generate:all",
		"deploy:cloudflare": "npm run build:cloudflare && wrangler pages deploy .svelte-kit/cloudflare --project-name=eda-resource-browser",
		"deploy:cloudflare:only": "npm run prune:cloudflare && wrangler pages deploy .svelte-kit/cloudflare --project-name=eda-resource-browser",
		"deploy:cloudflare:lean": "PUBLIC_FIX_AI_ENABLED=false npm run build:cloudflare && node scripts/deploy-cloudflare-lean.mjs",
		"deploy:cloudflare:phase1": "npm run build:cloudflare && wrangler pages deploy .svelte-kit/cloudflare --project-name=eda-resource-browser",
		"eval:fix": "tsx --tsconfig tsconfig.scripts.json scripts/eval-fix.ts",
		"generate:all": "npm run build:crd-scopes && npm run generate:sitemap && npm run generate:release-notes -- --skip-unchanged && npm run generate:openapi-manifest -- --all && npm run build:schema-graph -- --all",
		"validate:yaml": "tsx --tsconfig tsconfig.scripts.json scripts/validate-yaml.ts",
		"build:crd-scopes": "tsx --tsconfig tsconfig.scripts.json scripts/build-crd-scopes.ts"
	},
	"dependencies": {
		"@xyflow/svelte": "^1.7.0",
		"@xyflow/system": "^0.0.77",
		"ajv": "^8.20.0",
		"d3": "^7.9.0",
		"marked": "18.1.1",
		"mermaid": "12.2.0",
		"monaco-editor": "^0.52.2",
		"swagger-ui-dist": "^5.34.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@cloudflare/workers-types": "5.20261021.1",
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.5",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"@types/d3": "^7.4.3",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^25.9.9",
		"@vitest/browser": "^5.0.5",
		"@vitest/browser-playwright": "^5.0.5",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^16.5.0",
		"js-yaml": "^4.3.2",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-copy": "^2.0.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.0",
		"undici": "7.30.1",
		"vite": "^7.3.7",
		"vite-plugin-devtools-json": "^0.2.1",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.151.3"
	},
	"engines": {
		"node": ">=24.22.1"
	},
	"overrides": {
		"@sveltejs/kit": {
			"cookie": "^0.7.2"
		},
		"miniflare": {
			"undici": "7.30.1"
		}
	}
}
